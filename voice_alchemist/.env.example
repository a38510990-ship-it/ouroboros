# Voice Note Alchemist — environment variables
# Copy to .env and fill in your values

# ── Required ─────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here

# ── Access control (optional) ────────────────────────────────────────────────
# If set, only this Telegram user ID can use the bot.
# All other users will receive "⛔ Access denied."
# Leave commented out to allow anyone.
# ALLOWED_TELEGRAM_ID=123456789

# ── LLM summarisation (optional) ─────────────────────────────────────────────
# Enables automatic summarisation for long transcripts (>SUMMARY_MIN_CHARS).
# Get a key at https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-v1-...

# LLM model for summaries. Defaults to a fast, cheap Gemini model.
# OUROBOROS_MODEL_LIGHT=google/gemini-2.0-flash-001

# ── Transcription (optional) ──────────────────────────────────────────────────
# Whisper model size. "tiny" works on CPU (default).
# On a T4 GPU you can use: small, medium, large-v3
# WHISPER_MODEL=tiny

# Minimum transcript length (chars) to trigger LLM summarisation.
# SUMMARY_MIN_CHARS=500

# ── Storage (optional) ────────────────────────────────────────────────────────
# Base path for Google Drive. Default works on Colab.
# DRIVE_ROOT=/content/drive/MyDrive/Ouroboros
