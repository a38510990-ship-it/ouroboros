# Bookshelf Catalog Bot — Environment Variables
# Copy this file to bookshelf/.env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_token_here

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_key_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Name of the Google Spreadsheet to use/create (default: "Bookshelf Catalog")
# GOOGLE_SHEET_NAME=Bookshelf Catalog

# Vision model to use for book recognition (default: google/gemini-2.0-flash-001)
# Options:
#   google/gemini-2.0-flash-001       — fast, cheap, good quality (recommended)
#   anthropic/claude-3.5-sonnet       — best quality, higher cost
#   openai/gpt-4o                     — excellent alternative
#   google/gemini-2.0-flash-thinking-exp:free  — free tier (rate limited)
# VLM_MODEL=google/gemini-2.0-flash-001
