# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Sheets — name of the spreadsheet (will be created if not exists)
GOOGLE_SHEET_NAME=Bookshelf Catalog

# VLM model for book recognition (must support vision/images)
# Options:
#   google/gemini-2.0-flash-001          (fast, cheap, good quality)
#   anthropic/claude-3.5-sonnet          (excellent quality, moderate cost)
#   openai/gpt-4o                        (excellent quality, moderate cost)
#   google/gemini-2.5-pro-preview        (best quality, more expensive)
VLM_MODEL=google/gemini-2.0-flash-001

# Path to OAuth token (default: token.json next to bot.py)
# Usually no need to change this
# GOOGLE_TOKEN_PATH=bookshelf/token.json
