# Bookshelf Catalog Bot — Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (for VLM book recognition)
# Get one at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model for book recognition
# Options (sorted by quality):
#   anthropic/claude-3.5-sonnet        — best accuracy
#   openai/gpt-4o                      — excellent alternative
#   google/gemini-2.0-flash-001        — fast and cheap (default)
#   google/gemini-2.0-flash-thinking-exp:free  — free tier
VLM_MODEL=google/gemini-2.0-flash-001

# Google Sheets spreadsheet name (will be created if it doesn't exist)
GOOGLE_SHEET_NAME=Bookshelf Catalog
