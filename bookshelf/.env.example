# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter API Key (from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here

# Name of the Google Sheet to use (will be created automatically if not exists)
GOOGLE_SHEET_NAME=Bookshelf Catalog

# Vision model for book recognition (must support image input)
# Options: google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet, openai/gpt-4o
VLM_MODEL=google/gemini-2.0-flash-001

# Path to Google OAuth token (created by oauth_setup.py)
GOOGLE_TOKEN_PATH=token.json
