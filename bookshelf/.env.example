# Bookshelf Catalog Bot — переменные окружения
# Скопируй в .env и заполни

# Токен Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API ключ OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VLM модель для распознавания книг (опционально)
# VLM_MODEL=google/gemini-2.0-flash-001

# Имя CSV-файла в Google Drive (опционально)
# CATALOG_FILENAME=Bookshelf Catalog.csv
