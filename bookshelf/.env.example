# Bookshelf Catalog Bot — Environment Variables
# Copy this file to .env and fill in your values:
#   cp bookshelf/.env.example bookshelf/.env

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OpenRouter (VLM for book recognition) ─────────────────────────────────────
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VLM model to use for recognizing books in photos
# Options (best to fastest):
#   anthropic/claude-3.5-sonnet  — best quality, $3/M tokens
#   openai/gpt-4o                — excellent, $5/M tokens
#   google/gemini-2.0-flash-001  — fast & cheap (default)
VLM_MODEL=google/gemini-2.0-flash-001

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Name of the Google Spreadsheet to create/use
# The spreadsheet will be created in your Google Drive automatically
GOOGLE_SHEET_NAME=Bookshelf Catalog
