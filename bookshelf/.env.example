# Telegram Bot Token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Sheet name (will be created automatically if it doesn't exist)
GOOGLE_SHEET_NAME=Bookshelf Catalog

# VLM model for book recognition (choose one):
# google/gemini-2.0-flash-001        — fast and cheap (default)
# anthropic/claude-3.5-sonnet        — excellent quality, costs more
# openai/gpt-4o                      — excellent quality, costs more
# google/gemini-2.5-pro-preview      — best quality, costs more
VLM_MODEL=google/gemini-2.0-flash-001
