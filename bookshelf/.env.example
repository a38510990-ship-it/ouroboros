# ================================================
# Bookshelf Catalog Bot — Environment Variables
# ================================================
# Copy this file to .env and fill in your values:
#   cp bookshelf/.env.example bookshelf/.env

# --- Telegram ---
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- OpenRouter (for VLM book recognition) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- VLM Model (optional, defaults to gemini-2.0-flash-001) ---
# Fast & cheap (good for most photos):
# VLM_MODEL=google/gemini-2.0-flash-001
#
# Best quality:
# VLM_MODEL=anthropic/claude-3.5-sonnet
# VLM_MODEL=openai/gpt-4o
VLM_MODEL=google/gemini-2.0-flash-001

# --- Google Sheets ---
# Name of the spreadsheet to create/use in your Google Drive
# (no ID needed — just a name, bot creates it automatically)
GOOGLE_SHEET_NAME=Bookshelf Catalog
