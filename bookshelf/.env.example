# Bookshelf Catalog Bot — Environment Variables
# Copy this file to bookshelf/.env and fill in your values

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OpenRouter (VLM) ───────────────────────────────────────────────────────────
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model to use for book recognition
# Options (recommended):
#   google/gemini-2.0-flash-001    — fast, cheap, good quality (default)
#   anthropic/claude-3.5-sonnet   — best quality, higher cost
#   openai/gpt-4o                 — excellent alternative
VLM_MODEL=google/gemini-2.0-flash-001

# ── Google Sheets ──────────────────────────────────────────────────────────────
# Name of the spreadsheet to use (will be created if it doesn't exist)
GOOGLE_SHEET_NAME=Bookshelf Catalog
